# Copy to backend/.env and fill in. The .env file is git-ignored; never commit real keys.
# LLM API keys and the model are NOT set here: enter them on the Settings page (D9).
# Each external tool's provider is chosen here; only the chosen provider's key is needed (D38).

# Market data. Optional; default: finnhub
# MARKET_DATA_PROVIDER=finnhub
# Free key: https://finnhub.io
FINNHUB_API_KEY=

# Web search for the Research Agent. Optional; default: tavily
# SEARCH_PROVIDER=tavily
# Free key (1,000 searches/month): https://tavily.com
TAVILY_API_KEY=

# Daily price history for the watchlist charts. Optional; default: tiingo
# PRICE_HISTORY_PROVIDER=tiingo
# Free key: https://www.tiingo.com. Without it the app runs, but charts are unavailable.
TIINGO_API_KEY=
